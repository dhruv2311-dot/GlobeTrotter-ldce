{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "forceExit": true,
  "roots": ["<rootDir>/tests"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": {
        "strict": true,
        "esModuleInterop": true,
        "module": "commonjs"
      }
    }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/server.ts"
  ],
  "coverageReporters": ["text", "lcov"],
  "setupFiles": ["<rootDir>/tests/setup.ts"],
  "testTimeout": 10000,
  "clearMocks": true
}
